# ================================
# TOOLBOXHUB FRONTEND CONFIG
# ================================
# Set this to your Render URL (without trailing slash)
# Example: https://toolbox-hub-backend.onrender.com
NEXT_PUBLIC_API_URL=

# WebSocket URL for tools like ClipMaster
# Example: wss://toolbox-hub-backend.onrender.com
NEXT_PUBLIC_WS_URL=

# Branding
NEXT_PUBLIC_APP_NAME=ToolboxHub

# Google OAuth Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe Public Key (from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
