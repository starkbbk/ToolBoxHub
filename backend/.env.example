# ================================
# TOOLBOXHUB BACKEND CONFIG
# ================================

# General
APP_NAME=ToolboxHub
APP_VERSION=1.0.0
DEBUG=False

# Databases
# SQLite (Local/Legacy) - On Render, this won't persist without a Disk.
DATABASE_URL=sqlite:///./toolbox_hub.db
# MongoDB (Production) - Recommended: MongoDB Atlas free tier
MONGODB_URI=

# Security
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External APIs
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Product/Price IDs (Monthly/Yearly)
STRIPE_PRO_MONTHLY_ID=
STRIPE_ENT_MONTHLY_ID=
STRIPE_BUS_MONTHLY_ID=
STRIPE_CLA_MONTHLY_ID=
STRIPE_PRO_YEARLY_ID=
STRIPE_ENT_YEARLY_ID=
STRIPE_BUS_YEARLY_ID=
STRIPE_CLA_YEARLY_ID=

# CORS & Frontend URLs
# IMPORTANT: Update these with your Vercel URL after deployment
CORS_ORIGINS=https://toolbox-hub.vercel.app,http://localhost:3000
FRONTEND_URL=https://toolbox-hub.vercel.app

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=2048

# AI Services
OPENROUTER_API_KEY=
GROQ_API_KEY=
AI_MODEL=qwen/qwen-2.5-72b-instruct:free
